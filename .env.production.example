# Copy this file to .env.production and set strong values. .env.production is not committed.

# Do not quote the values, and avoid ";" and "$" in passwords (they break the connection string).

# Address and port on which the application is published over HTTPS (nginx).
# 127.0.0.1 keeps it local; on a server, use 0.0.0.0 and 443.
APP_ADDRESS=127.0.0.1
APP_PORT=8443

# Directory with the certificate: fullchain.pem and privkey.pem. The default ./certs
# is where make prod-cert writes a self-signed certificate (not committed).
CERT_DIR=./certs

MYSQL_DATABASE=revision_platform
MYSQL_USER=revision_platform
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
