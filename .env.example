# Copy this file to .env and adjust the values. .env is not committed.

# Host port for the MySQL container (3307 avoids clashing with a local MySQL on 3306).
MYSQL_PORT=3307

# Application database and user. A "<MYSQL_DATABASE>_test" database is also
# created for integration tests (see docker/mysql/init).
MYSQL_DATABASE=revision_platform
MYSQL_USER=revision_platform
MYSQL_PASSWORD=change-me

MYSQL_ROOT_PASSWORD=change-me-root
